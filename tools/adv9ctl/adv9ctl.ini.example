# ADV9 遠端控制工具設定（把本檔改名成 adv9ctl.ini 放在 adv9ctl.py 同層）
# 也可以在互動選單第一次執行時自動產生。

# 伺服器 IP 或網址（必填）
HOST=

# 登入帳號（必填，例如 ubuntu / root / yuan）
USER=

# SSH 連接埠
PORT=22

# SSH 密碼（留空＝不存密碼，改用 SSH 金鑰登入或每次輸入）
# 注意：填了就會以明文存在這個檔案，請自行保管好
PASSWORD=

# 後端程式在伺服器上的資料夾（放 server.js 與 public/ 的地方）
APPDIR=/home/你的帳號/adv9

# 後端 systemd 服務名（用 Docker 安裝的請把 MODE 改成 docker）
SVC=adv9

# 公開通道（cloudflared）systemd 服務名
TUNNEL=adv9-tunnel

# 重啟方式：systemd（Linux 服務）或 docker（Docker Compose）
MODE=systemd

# 本機要上傳的資料夾（deploy 用；預設與本檔同層的 server/，可改絕對路徑）
SERVER_SRC=server